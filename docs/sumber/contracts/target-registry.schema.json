{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "file2_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "file2_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "ssh_jump",
              "gns3_compute",
              "gns3_server",
              "application",
              "device",
              "generator",
              "evidence_sink"
            ]
          },
          "environment": {
            "enum": [
              "isolated_lab",
              "staging",
              "ci"
            ]
          },
          "host_alias": {
            "type": "string",
            "minLength": 1
          },
          "expected_host_identity": {
            "type": "string",
            "minLength": 1
          },
          "allowed_management_ips": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "access_kind": {
            "enum": [
              "ssh",
              "https",
              "none"
            ]
          },
          "jump_target_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "ssh_port": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "ssh_host_key_sha256": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "api_base_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://[^/]+(?:/.*)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tls_certificate_sha256_hex": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tls_ca_bundle_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "compute_target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "secret_binding_names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "permitted_operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "failure_domain": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target_id",
          "kind",
          "environment",
          "host_alias",
          "expected_host_identity",
          "allowed_management_ips",
          "access_kind",
          "jump_target_id",
          "ssh_port",
          "ssh_host_key_sha256",
          "api_base_url",
          "tls_certificate_sha256_hex",
          "tls_ca_bundle_ref",
          "compute_target_ids",
          "secret_binding_names",
          "permitted_operations",
          "failure_domain"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "access_kind": {
                  "const": "ssh"
                }
              }
            },
            "then": {
              "properties": {
                "ssh_port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "ssh_host_key_sha256": {
                  "type": "string",
                  "pattern": "^SHA256:[A-Za-z0-9+/]{43}=?$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "access_kind": {
                  "const": "https"
                }
              }
            },
            "then": {
              "properties": {
                "api_base_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "tls_certificate_sha256_hex": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "file2_manifest_id",
    "file2_sha256",
    "records"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:MicroTix:target-registry:1.0"
}
