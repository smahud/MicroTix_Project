{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_contract_version": {
      "const": "2.1"
    },
    "package_revision": {
      "const": "2.1-build.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "const": "READY"
    },
    "kind": {
      "enum": [
        "local",
        "ci"
      ]
    },
    "stage": {
      "enum": [
        "build",
        "test"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "const": "C"
        },
        "granted": {
          "const": true
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "proof_ref": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "scope_task_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TK-[0-9]{3,4}$"
          },
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "document",
              "code",
              "local_test",
              "local_build"
            ]
          }
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "mode",
        "granted",
        "owner_ref",
        "proof_ref",
        "workspace",
        "scope_task_ids",
        "operations",
        "valid_from",
        "expires_at",
        "scope_sha256"
      ]
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runner_path": {
      "type": "string",
      "minLength": 1
    },
    "toolchain_lock_path": {
      "type": "string",
      "minLength": 1
    },
    "config_snapshot_path": {
      "type": "string",
      "minLength": 1
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_directory": {
      "type": "string",
      "minLength": 1
    },
    "target_ids": {
      "type": "array",
      "maxItems": 0
    },
    "remote_access": {
      "const": false
    },
    "production_access": {
      "const": false
    },
    "external_messaging": {
      "const": false
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_cores": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "disk_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_processes": {
          "type": "integer",
          "minimum": 1
        },
        "run_deadline_s": {
          "type": "integer",
          "minimum": 1
        },
        "cleanup_reserve_s": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "cpu_cores",
        "memory_bytes",
        "disk_bytes",
        "max_processes",
        "run_deadline_s",
        "cleanup_reserve_s"
      ]
    },
    "egress_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "kind_deadlines_s": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 15
      }
    },
    "retry_base_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 300
    },
    "fixture_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "secret_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provider_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "provider_ref"
        ]
      },
      "uniqueItems": true
    },
    "release": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "document_contract_version",
    "package_revision",
    "profile_id",
    "state",
    "kind",
    "stage",
    "authorization",
    "manifest_sha256",
    "workspace",
    "source_commit",
    "artifact_sha256",
    "runner_path",
    "toolchain_lock_path",
    "config_snapshot_path",
    "config_sha256",
    "evidence_directory",
    "target_ids",
    "remote_access",
    "production_access",
    "external_messaging",
    "resource_budget",
    "egress_allowlist",
    "kind_deadlines_s",
    "retry_base_s",
    "fixture_refs",
    "secret_bindings",
    "release",
    "features",
    "resource_types"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:MicroTix:execution-profile:1.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "test"
          }
        }
      },
      "then": {
        "properties": {
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
